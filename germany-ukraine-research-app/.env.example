# Germany-Ukraine Contact Research - Umgebungsvariablen

# ===== FIREBASE KONFIGURATION (ERFORDERLICH) =====
# Pfad zur Firebase Service Account JSON-Datei
FIREBASE_CONFIG_PATH=config/firebase-config.json

# Für self-hosted Firebase: URL Ihrer Firebase-Instanz
# Beispiel: https://your-firebase-instance.com oder http://localhost:8080 (für Emulator)
FIREBASE_URL=https://your-firebase-instance.com

# Optional: Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Für Firebase Emulator Suite (optional, für lokale Entwicklung):
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ===== OPTIONAL: SERPAPI =====
# Für erweiterte Web-Suche (für erweiterte Funktionen)
# Registriere dich auf https://serpapi.com für einen API-Key
SERPAPI_KEY=your_serpapi_key_here

# ===== FLASK KONFIGURATION =====
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ===== UPDATE-EINSTELLUNGEN =====
AUTO_UPDATE=true
UPDATE_FREQUENCY_DAYS=7

# ===== SCRAPING-EINSTELLUNGEN =====
SCRAPING_DELAY=2
SCRAPING_TIMEOUT=30
