# Germany-Ukraine Contact Research - Umgebungsvariablen

# Datenbank (SQLite wird standardmäßig verwendet)
DATABASE_PATH=data/contacts.db

# Optional: SerpAPI für Web-Suche (für erweiterte Funktionen)
# Registriere dich auf https://serpapi.com für einen API-Key
SERPAPI_KEY=your_serpapi_key_here

# Flask-Konfiguration
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Update-Einstellungen
AUTO_UPDATE=true
UPDATE_FREQUENCY_DAYS=7

# Scraping-Einstellungen
SCRAPING_DELAY=2
SCRAPING_TIMEOUT=30
